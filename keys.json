{
  "layout:hotpot": {
    "ctrl-shift-h": {
      "command": "layout.toggle",
      "args": {
        "id": "hotpot"
      }
    },
    "ctrl-shift-i": {
      "command": "layout.select",
      "args": {
        "stack": "main-stack",
        "child": "inspector"
      }
    },
    "ctrl-shift-m": {
      "command": "layout.select",
      "args": {
        "stack": "main-stack",
        "child": "main"
      }
    },
    "alt-t": "hotpot-session:pty-focus"
  }
}
